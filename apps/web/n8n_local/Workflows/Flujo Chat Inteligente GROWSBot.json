    {
      "parameters": {
        "functionCode": "const entidad = $json.entidad || 'obra';\nlet data = '';\n\nswitch (entidad) {\n  case 'obra':\n    data = `🏗️ Obras activas:\n- Casa López\n- P.Mitre\n- Jardines de Esther`;\n    break;\n\n  case 'tarea':\n    data = `📋 Tareas en ejecución: 12\nFinalizadas: 2\nEn revisión: 1`;\n    break;\n\n  case 'calendario':\n    data = `🗓️ Próximas inspecciones:\n- 21/10\n- 23/10`;\n    break;\n\n  default:\n    data = `⚠️ Consulta no reconocida.`;\n    break;\n}\n\nreturn [{ json: { respuesta: data } }];\n"
      },
      "id": "16072cb6-a882-47c2-bf62-bfd055407253",
      "name": "Responder datos GROWS",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [
        1184,
        112
      ]
    },
    {
      "parameters": {
        "jsCode": "// --- Extraer correctamente el texto del mensaje ---\nconst msg = $json.contexto?.chatInput || $json.chatInput || $json.message || $json.body || '';\nlet categoria = 'fuera_de_tema';\nlet accion = null;\n\n// --- Clasificación simple por palabras clave ---\nif (/arquitectura|materiales|estructura|presupuesto/i.test(msg))\n  categoria = 'construccion_general';\n\nif (/obra|tarea|cuadrilla|notificacion|calendario|pago|reporte|cuenta/i.test(msg))\n  categoria = 'grows_textual';\n\nif (/crear|nueva|agregar/i.test(msg)) {\n  categoria = 'grows_accion';\n  accion = 'crear';\n}\n\nif (/asignar|vincular|enviar/i.test(msg)) {\n  categoria = 'grows_accion';\n  accion = 'asignar';\n}\n\nif (/estado|avance|cómo va|qué pasa/i.test(msg))\n  categoria = 'grows_consulta';\n\n// --- Debug log (opcional) ---\nconsole.log(\"Texto detectado:\", msg);\nconsole.log(\"Categoría:\", categoria, \"Acción:\", accion);\n\n// --- Salida ---\nreturn [{ json: { categoria, accion, chatInput: msg } }];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -32,
        -192
      ],
      "id": "33fc9537-a6ae-44c2-a5ad-9f0b5be86694",
      "name": "Clasificar tipo de consulta",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "functionCode": "const accion = $json.accion || '';\nconst entidad = $json.entidad || 'obra';\nlet response = '';\n\nif (accion === 'crear' && entidad === 'obra') {\n  response = '✅ Obra creada correctamente.';\n} else if (accion === 'asignar' && entidad === 'tarea') {\n  response = '🧱 Tarea asignada correctamente.';\n} else if (accion === 'asignar' && entidad === 'cuadrilla') {\n  response = '👷‍♂️ Cuadrilla asignada correctamente.';\n} else {\n  response = '⚠️ Acción no reconocida o pendiente.';\n}\n\nreturn [{ json: { respuesta: response } }];\n"
      },
