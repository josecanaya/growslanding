{
  "name": "grows-monorepo",
  "version": "1.0.0",
  "description": "Monorepo GROWS con Next.js + Prisma + PostgreSQL",
  "private": true,
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "dev": "pnpm --filter apps/landing dev",
    "build": "pnpm --filter apps/landing build",
    "start": "pnpm --filter apps/landing start",
    "lint": "pnpm --filter apps/landing lint",
    "test": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "prisma": "^5.7.1",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0",
    "ts-node": "^10.9.2"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  }
}

