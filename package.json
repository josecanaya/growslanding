{
  "name": "grows-monorepo",
  "version": "1.0.0",
  "description": "Monorepo GROWS con Next.js + Prisma + PostgreSQL",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "dev": "cd apps/landing && npm run dev",
    "dev:web": "cd apps/web && npm run dev",
    "build": "pnpm --filter ./apps/landing run build",
    "build:web": "pnpm --filter ./apps/web run build",
    "start": "cd apps/landing && npm run start",
    "start:web": "cd apps/web && npm run start",
    "lint": "cd apps/landing && npm run lint",
    "lint:web": "cd apps/web && npm run lint",
    "test": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^7.0.0",
    "@radix-ui/react-tabs": "^1.1.13",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "prisma": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.12"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  }
}
