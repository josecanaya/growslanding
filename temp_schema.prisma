generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Obra {
  id                String      @id @default(uuid())
  nombre            String
  localizacion         String?
  estado            String      @default("ACTIVA")
  created_at         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
}


