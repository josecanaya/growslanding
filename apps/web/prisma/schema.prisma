generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Obra {
  id           String   @id @default(uuid())
  nombre       String
  localizacion String?
  cliente      String?
  estado       String   @default("ACTIVA")
  
  // Nuevos campos para datos generales
  cantidad_plantas              Int?
  superficie_por_planta         Float?
  superficie_total              Float?
  ancho_terreno                 Float?
  largo_terreno                 Float?
  ancho_planta                  Float?
  largo_planta                  Float?
  tipo_proyecto                 String? // Vivienda unifamiliar, Vivienda multifamiliar, Ampliación, Refacción
  coordenadas_lat               Float?
  coordenadas_lng               Float?
  direccion_completa            String?
  fecha_inicio                  String?
  presupuesto                   String?
  descripcion                   String?
  
  created_at   DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

// Tablas del Roadmap
model RoadmapObjetivo {
  id          String   @id @default(uuid())
  titulo      String
  descripcion String?
  prioridad   String   @default("MEDIA")
  estado      String   @default("PENDIENTE")
  progreso    Float    @default(0)
  startWeek   Int?
  endWeek     Int?
  targetWeeks Int?
  dueDate     DateTime?
  collapsed   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relaciones
  tareas      RoadmapTarea[]
  gruposTareas RoadmapGrupoTareas[]
}

model RoadmapGrupoTareas {
  id          String   @id @default(uuid())
  titulo      String
  descripcion String?
  objetivoId  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relaciones
  objetivo    RoadmapObjetivo @relation(fields: [objetivoId], references: [id], onDelete: Cascade)
  tareas      RoadmapTarea[]
}

model RoadmapTarea {
  id          String   @id @default(uuid())
  texto       String
  estado      String   @default("pending")
  done        Boolean  @default(false)
  estimateHrs Int?
  owner       String?
  prioridad   String   @default("MEDIA")
  dueDate     DateTime?
  objetivoId  String?
  grupoId     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  // Relaciones
  objetivo    RoadmapObjetivo? @relation(fields: [objetivoId], references: [id], onDelete: Cascade)
  grupo       RoadmapGrupoTareas? @relation(fields: [grupoId], references: [id], onDelete: Cascade)
}