# ─────────────────────────────────────────────────────────────
# Grows · apps/web — variables de entorno (plantilla, SIN secretos)
# Copiá este archivo a .env.local y completá los valores.
# En Vercel: Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Supabase
USE_MOCK_DATA=false
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...    # anon key (pública)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...                # anon key (server, opcional)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...        # service role (SOLO server, privada)

# Google Maps (Places / JS loader)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIza...

# ── MCP para ChatGPT (conector remoto) ───────────────────────
# Token Bearer que ChatGPT envía para autenticar contra /api/mcp.
# Sin este valor el endpoint responde 503 y ChatGPT no conecta.
# Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
GROWS_MCP_TOKEN=pon-aqui-un-secreto-largo-aleatorio
# Opcional: UUID de tu org para acotar las obras que ve ChatGPT (vacío = todas)
GROWS_MCP_ORG_ID=
