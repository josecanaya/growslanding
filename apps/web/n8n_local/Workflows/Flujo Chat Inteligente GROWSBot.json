    {
      "parameters": {
        "jsCode": "// Lee el contexto desde $binary (base64) o desde $json (objeto o string)\nconst binKeys = Object.keys($binary || {});\n\nlet base64 = null;\nif (typeof $binary?.data === 'string') {\n  base64 = $binary.data;\n} else if (typeof $binary?.data?.data === 'string') {\n  base64 = $binary.data.data;\n}\n\nlet texto = null;\nlet contexto = null;\nlet parseError = null;\nlet fuente = null;\n\nif (base64) {\n  // Caso 1: viene como binario base64\n  try {\n    texto = Buffer.from(base64, 'base64').toString('utf8');\n    contexto = JSON.parse(texto);\n    fuente = 'binary';\n  } catch (e) {\n    parseError = e.message;\n    fuente = 'binary';\n  }\n} else {\n  // Caso 2: no hay base64; intentamos con $json\n  if (typeof $json === 'string') {\n    texto = $json;\n    try {\n      contexto = JSON.parse(texto);\n      fuente = 'json-string';\n    } catch (e) {\n      parseError = e.message;\n      fuente = 'json-string';\n    }\n  } else if ($json && typeof $json === 'object' && Object.keys($json).length) {\n    // Ya está parseado\n    contexto = $json;\n    texto = JSON.stringify($json);\n    fuente = 'json-object';\n  } else {\n    return [{\n      json: {\n        ok: false,\n        error: 'No se encontró contenido en $binary ni en $json.',\n        binaryKeys: binKeys,\n        rawType: typeof $binary?.data\n      }\n    }];\n  }\n}\n\nreturn [{\n  json: {\n    ok: true,\n    fuente,\n    binaryKeys: binKeys,\n    length: texto ? texto.length : null,\n    contexto,        // Objeto listo para usar en el siguiente nodo\n    textoPlano: texto,\n    parseError       // null si parseó ok\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -256,
