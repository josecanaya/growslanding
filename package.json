{
  "name": "grows-monorepo",
  "version": "1.0.0",
  "description": "Monorepo GROWS con Next.js + Prisma + PostgreSQL",
  "private": true,
  "scripts": {
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "dev": "cd apps/landing && npm run dev",
    "dev:web": "cd apps/web && npm run dev",
    "build": "cd apps/landing && npm install && npm run build",
    "build:web": "cd apps/web && npm install && npm run build",
    "start": "cd apps/landing && npm run start",
    "start:web": "cd apps/web && npm run start",
    "lint": "cd apps/landing && npm run lint",
    "lint:web": "cd apps/web && npm run lint",
    "test": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^5.7.1",
    "@radix-ui/react-tabs": "^1.1.13",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "prisma": "^5.7.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.6.2",
    "typescript": "^5.3.3",
    "vitest": "^1.1.0"
  },
  "prisma": {
    "seed": "ts-node --transpile-only prisma/seed.ts"
  }
}
