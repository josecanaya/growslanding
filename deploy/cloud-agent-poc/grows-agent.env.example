# Grows Cloud Worker — configuración del servicio
#
# Copiar a /etc/grows-agent/grows-agent.env y completar los dos valores.
#
#   sudo install -d -m 0750 -o root -g grows-agent /etc/grows-agent
#   sudo cp grows-agent.env.example /etc/grows-agent/grows-agent.env
#   sudo chown root:grows-agent /etc/grows-agent/grows-agent.env
#   sudo chmod 0640 /etc/grows-agent/grows-agent.env
#   sudo nano /etc/grows-agent/grows-agent.env
#
# ESTE ARCHIVO (el .example) NO debe contener nunca el token real.
# El archivo real vive solo en la VM, jamás en git.

# Origen de Grows. Debe ser HTTPS (el worker rechaza HTTP salvo localhost).
# Es la misma URL que aparece en el link grows://pair?url=...
GROWS_BRIDGE_URL=https://app.grows.com.ar

# Token del dispositivo emparejado: 64 caracteres hexadecimales.
# Se obtiene UNA sola vez al tocar "Conectar" en Grows (ver README, PARTE 4).
# Si lo perdés, generá uno nuevo desde Grows; el anterior queda huérfano.
GROWS_BRIDGE_TOKEN=pegar-aqui-el-token-de-64-hex
